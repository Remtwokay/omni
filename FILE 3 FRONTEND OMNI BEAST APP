<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Omni Beast – Real AI Search</title>
<meta name="theme-color" content="#0b0e13">
<style>
:root {
  --bg: #0b0e13;
  --panel: #141a22;
  --panel2: #1c2430;
  --line: #2a3444;
  --text: #e8eaed;
  --dim: #8b95a5;
  --amber: #f0b429;
  --teal: #4ecdc4;
  --radius: 14px;
}
[data-theme="light"] {
  --bg: #f0f2f5;
  --panel: #ffffff;
  --panel2: #e8ecf1;
  --line: #d0d7e2;
  --text: #1a1f2a;
  --dim: #5a6a7e;
  --amber: #d4920a;
  --teal: #0f766e;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, sans-serif;
  min-height: 100vh;
  transition: background .25s, color .25s;
}
.wrap { max-width: 820px; margin: 0 auto; padding: 24px 16px 60px; }

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}
.logo {
  font-size: 1.8rem;
  font-weight: 800;
  background: linear-gradient(135deg, #fff 10%, var(--amber));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
[data-theme="light"] .logo {
  background: linear-gradient(135deg, #111, var(--amber));
  -webkit-background-clip: text;
}
.header-right { display: flex; gap: 8px; align-items: center; }
.theme-btn, .mode-btn {
  height: 38px;
  padding: 0 14px;
  border: 1px solid var(--line);
  background: var(--panel2);
  border-radius: 10px;
  font-size: 0.85rem;
  cursor: pointer;
  color: var(--text);
  font-weight: 500;
}
.mode-btn.active {
  background: var(--amber);
  color: #111;
  border-color: var(--amber);
}

.search-shell { position: relative; margin-bottom: 12px; }
#q {
  width: 100%;
  padding: 16px 110px 16px 18px;
  font-size: 1.05rem;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  color: var(--text);
  outline: none;
}
#q:focus { border-color: var(--amber); box-shadow: 0 0 0 3px rgba(240,180,41,.18); }
.actions {
  position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
  display: flex; gap: 6px;
}
.btn {
  width: 38px; height: 38px;
  border: none; border-radius: 10px;
  background: var(--panel2);
  color: var(--text);
  font-size: 1.1rem;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.go { background: var(--amber); color: #111; font-weight: 700; }
.listening { background: #e74c3c !important; color: #fff; }

#suggest {
  display: none;
  position: absolute; left: 0; right: 0; top: calc(100% + 5px);
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 12px;
  max-height: 280px;
  overflow-y: auto;
  z-index: 50;
  box-shadow: 0 12px 30px rgba(0,0,0,.3);
}
#suggest.show { display: block; }
.sug { padding: 11px 16px; cursor: pointer; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
.sug:hover { background: var(--panel2); color: var(--amber); }

.chips { display: flex; flex-wrap: wrap; gap: 7px; margin: 12px 0; }
.chip {
  font-size: 0.76rem;
  padding: 5px 12px;
  background: var(--panel2);
  border: 1px solid var(--line);
  border-radius: 999px;
  cursor: pointer;
  color: var(--dim);
}
.chip:hover { border-color: var(--amber); color: var(--text); }

#out { margin-top: 18px; min-height: 80px; }
.card {
  display: flex; gap: 14px;
  padding: 16px;
  margin-bottom: 12px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}
.card.top {
  border-color: rgba(240,180,41,.5);
  background: linear-gradient(145deg, var(--panel2), var(--panel));
}
.icon { font-size: 1.35rem; flex-shrink: 0; }
.title { color: var(--amber); font-weight: 650; font-size: 1.05rem; margin-bottom: 6px; }
.desc { font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; }
.meta { font-size: 0.8rem; color: var(--dim); margin-top: 8px; }
.link { color: var(--teal); font-size: 0.88rem; text-decoration: none; }

.ai-box {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 18px;
  margin-bottom: 14px;
  line-height: 1.65;
  white-space: pre-wrap;
}
.ai-box .label {
  font-size: 0.78rem;
  color: var(--amber);
  font-weight: 600;
  margin-bottom: 8px;
  display: block;
}

.loading { display: flex; align-items: center; gap: 12px; color: var(--dim); padding: 10px 0; }
.spinner {
  width: 18px; height: 18px;
  border: 2.5px solid var(--line);
  border-top-color: var(--amber);
  border-radius: 50%;
  animation: spin .6s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.footer {
  text-align: center;
  color: var(--dim);
  font-size: 0.76rem;
  margin-top: 50px;
  line-height: 1.6;
}
</style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <div class="logo">Omni Beast</div>
    <div class="header-right">
      <button class="mode-btn" id="modeBtn" onclick="toggleMode()">AI Mode: OFF</button>
      <button class="theme-btn" onclick="toggleTheme()">◐</button>
    </div>
  </div>

  <div class="search-shell">
    <input id="q" type="text" placeholder="Ask anything or search…" autocomplete="off">
    <div class="actions">
      <button class="btn" id="voiceBtn" onclick="toggleVoice()">🎤</button>
      <button class="btn go" onclick="go()">→</button>
    </div>
    <div id="suggest"></div>
  </div>

  <div class="chips">
    <span class="chip" onclick="setQ('What is quantum computing?')">Quantum computing</span>
    <span class="chip" onclick="setQ('Bitcoin price')">Bitcoin</span>
    <span class="chip" onclick="setQ('weather Nairobi')">Weather</span>
    <span class="chip" onclick="setQ('100 usd to kes')">USD → KES</span>
    <span class="chip" onclick="setQ('Who is the president of Kenya?')">President of Kenya</span>
  </div>

  <div id="out"></div>

  <div class="footer">
    Omni Beast – Real AI + Web Search when AI Mode is ON<br>
    Requires Cloudflare Worker + Groq key for full Beast Mode
  </div>
</div>

<script>
// ============================================================
// PASTE YOUR CLOUDFLARE WORKER URL HERE
const WORKER_URL = "YOUR_WORKER_URL";
// ============================================================

const qInput = document.getElementById('q');
const out = document.getElementById('out');
const suggestBox = document.getElementById('suggest');
const modeBtn = document.getElementById('modeBtn');

let aiMode = false;
let history = [];
let abortCtrl = null;

// Theme
function toggleTheme() {
  const isLight = document.documentElement.getAttribute('data-theme') === 'light';
  document.documentElement.setAttribute('data-theme', isLight ? '' : 'light');
  localStorage.setItem('omni-theme', isLight ? 'dark' : 'light');
}
if (localStorage.getItem('omni-theme') === 'light') {
  document.documentElement.setAttribute('data-theme', 'light');
}

// AI Mode toggle
function toggleMode() {
  aiMode = !aiMode;
  modeBtn.textContent = aiMode ? 'AI Mode: ON' : 'AI Mode: OFF';
  modeBtn.classList.toggle('active', aiMode);
  if (aiMode && WORKER_URL === 'YOUR_WORKER_URL') {
    alert('Please set your Cloudflare Worker URL first to enable real AI Mode.');
    aiMode = false;
    modeBtn.textContent = 'AI Mode: OFF';
    modeBtn.classList.remove('active');
  }
}

// Voice
let recog = null;
function toggleVoice() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) return alert('Voice not supported');
  if (!recog) {
    recog = new SR();
    recog.lang = 'en-US';
    recog.onresult = e => {
      qInput.value = e.results[0][0].transcript;
      document.getElementById('voiceBtn').classList.remove('listening');
      go();
    };
    recog.onend = () => document.getElementById('voiceBtn').classList.remove('listening');
  }
  const btn = document.getElementById('voiceBtn');
  if (btn.classList.contains('listening')) {
    recog.stop();
    btn.classList.remove('listening');
  } else {
    btn.classList.add('listening');
    recog.start();
  }
}

// Autocomplete
let timer = null;
qInput.addEventListener('input', () => {
  clearTimeout(timer);
  const v = qInput.value.trim();
  if (v.length < 2) { suggestBox.classList.remove('show'); return; }
  timer = setTimeout(async () => {
    try {
      const res = await fetch(`https://en.wikipedia.org/w/api.php?action=opensearch&search=${encodeURIComponent(v)}&limit=6&origin=*`).then(r => r.json());
      const list = res[1] || [];
      if (!list.length) return suggestBox.classList.remove('show');
      suggestBox.innerHTML = list.map(s => `<div class="sug" onclick="setQ('${s.replace(/'/g,"\\'")}')">${s}</div>`).join('');
      suggestBox.classList.add('show');
    } catch { suggestBox.classList.remove('show'); }
  }, 180);
});
document.addEventListener('click', e => {
  if (!e.target.closest('.search-shell')) suggestBox.classList.remove('show');
});
qInput.addEventListener('keydown', e => { if (e.key === 'Enter') go(); });

function setQ(text) {
  qInput.value = text;
  suggestBox.classList.remove('show');
  go();
}

// ========== MAIN ==========
async function go() {
  const query = qInput.value.trim();
  if (!query) return;
  suggestBox.classList.remove('show');
  out.innerHTML = '';

  if (aiMode) {
    return runAI(query);
  }

  // Local smart mode (no AI)
  runLocal(query);
}

// ========== REAL AI MODE (calls your Worker) ==========
async function runAI(query) {
  out.innerHTML = `<div class="loading"><div class="spinner"></div> Omni Beast is thinking…</div>`;

  try {
    const res = await fetch(WORKER_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: query, history })
    });

    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.error || 'AI request failed');
    }

    // Streaming
    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let full = '';

    out.innerHTML = `
      <div class="ai-box">
        <span class="label">OMNI BEAST AI</span>
        <div id="aiText"></div>
      </div>`;

    const aiText = document.getElementById('aiText');

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      const chunk = decoder.decode(value, { stream: true });
      full += chunk;
      aiText.textContent = full;
    }

    // Simple linkify
    aiText.innerHTML = full
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/(https?:\/\/[^\s\)]+)/g, '<a class="link" href="$1" target="_blank" rel="noopener">$1</a>');

    history.push({ role: 'user', content: query });
    history.push({ role: 'assistant', content: full });
    if (history.length > 12) history = history.slice(-12);

  } catch (err) {
    out.innerHTML = `
      <div class="card">
        <div class="desc">
          <strong>AI Mode Error:</strong><br>
          ${err.message}<br><br>
          Make sure you have set the correct WORKER_URL and added your GROQ_API_KEY in Cloudflare.
        </div>
      </div>`;
  }
}

// ========== LOCAL SMART MODE (no key needed) ==========
function runLocal(query) {
  const lower = query.toLowerCase();

  // Math
  const mathStr = lower.replace(/[a-z\s]/g, '');
  if (mathStr && /^[\d+\-*/().]+$/.test(mathStr) && /[+\-*/]/.test(mathStr)) {
    try {
      const result = Function('"use strict";return(' + mathStr + ')')();
      return showLocal('🔢', query, `<div style="font-size:1.5rem;font-weight:600">${result}</div>`);
    } catch {}
  }

  // Currency
  const cur = lower.match(/(\d+\.?\d*)\s*([a-z]{3})\s+(?:to|in)\s+([a-z]{3})/);
  if (cur) return doCurrency(+cur[1], cur[2].toUpperCase(), cur[3].toUpperCase());

  // Crypto
  if (/bitcoin|btc|ethereum|eth|solana|dogecoin/i.test(lower)) return doCrypto(lower);

  // Weather
  if (/weather|temperature|forecast/i.test(lower)) return doWeather(query);

  // Default → Wikipedia + DuckDuckGo
  doSearch(query);
}

function showLocal(icon, title, body) {
  out.innerHTML = `
    <div class="card top">
      <div class="icon">${icon}</div>
      <div>
        <div class="title">${esc(title)}</div>
        <div class="desc">${body}</div>
      </div>
    </div>`;
}

async function doCurrency(amount, from, to) {
  out.innerHTML = `<div class="loading"><div class="spinner"></div> Converting…</div>`;
  try {
    const d = await fetch(`https://api.frankfurter.app/latest?amount=${amount}&from=${from}&to=${to}`).then(r => r.json());
    showLocal('💱', `${amount} ${from} → ${to}`,
      `<div style="font-size:1.4rem;font-weight:600">${d.rates[to].toLocaleString()} ${to}</div>`);
  } catch {
    out.innerHTML = `<div class="card"><div class="desc">Conversion failed</div></div>`;
  }
}

async function doCrypto(lower) {
  out.innerHTML = `<div class="loading"><div class="spinner"></div> Fetching price…</div>`;
  const map = {bitcoin:'bitcoin',btc:'bitcoin',ethereum:'ethereum',eth:'ethereum',solana:'solana',dogecoin:'dogecoin'};
  let id = 'bitcoin';
  for (const k in map) if (lower.includes(k)) { id = map[k]; break; }
  try {
    const d = await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${id}&vs_currencies=usd&include_24hr_change=true`).then(r => r.json());
    const c = d[id];
    showLocal('🪙', id, `<div style="font-size:1.4rem;font-weight:600">$${c.usd.toLocaleString()}</div>
      <div class="meta">${c.usd_24h_change?.toFixed(2)}% (24h)</div>`);
  } catch {
    out.innerHTML = `<div class="card"><div class="desc">Price unavailable</div></div>`;
  }
}

async function doWeather(q) {
  out.innerHTML = `<div class="loading"><div class="spinner"></div> Weather…</div>`;
  const city = q.replace(/^(weather|temperature|forecast)\s*(in|for)?\s*/i, '').trim() || 'Nairobi';
  try {
    const geo = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(city)}&format=json&limit=1`).then(r => r.json());
    if (!geo[0]) throw 0;
    const { lat, lon, display_name } = geo[0];
    const w = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code,wind_speed_10m`).then(r => r.json());
    const codes = {0:'Clear',1:'Mainly clear',2:'Partly cloudy',3:'Overcast',61:'Rain',95:'Thunderstorm'};
    showLocal('🌤️', display_name.split(',')[0],
      `<div style="font-size:1.35rem;font-weight:600">${w.current.temperature_2m}°C · ${codes[w.current.weather_code]||'—'}</div>`);
  } catch {
    out.innerHTML = `<div class="card"><div class="desc">Weather not found</div></div>`;
  }
}

async function doSearch(query) {
  out.innerHTML = `<div class="loading"><div class="spinner"></div> Searching…</div>`;
  const enc = encodeURIComponent(query);
  try {
    const [wiki, ddg] = await Promise.all([
      fetch(`https://en.wikipedia.org/api/rest_v1/page/summary/${enc}`).then(r => r.ok ? r.json() : null).catch(() => null),
      fetch(`https://api.duckduckgo.com/?q=${enc}&format=json&no_html=1&skip_disambig=1&origin=*`).then(r => r.json()).catch(() => null)
    ]);

    let html = '';
    if (wiki?.extract) {
      html += `
        <div class="card top">
          <div class="icon">📖</div>
          <div>
            <div class="title">${esc(wiki.title)}</div>
            <div class="desc">${esc(wiki.extract)}</div>
            <a class="link" href="${wiki.content_urls?.desktop?.page}" target="_blank">Read full article →</a>
          </div>
        </div>`;
    }
    if (ddg?.AbstractText) {
      html += `
        <div class="card">
          <div class="icon">🦆</div>
          <div>
            <div class="title">${esc(ddg.Heading || 'Answer')}</div>
            <div class="desc">${esc(ddg.AbstractText)}</div>
          </div>
        </div>`;
    }
    out.innerHTML = html || `<div class="card"><div class="desc">No results found</div></div>`;
  } catch {
    out.innerHTML = `<div class="card"><div class="desc">Search failed</div></div>`;
  }
}

function esc(s) {
  if (!s) return '';
  const d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}
</script>
</body>
</html>
